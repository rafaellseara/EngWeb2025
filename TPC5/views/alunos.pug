extends layout

block content
    .w3-card-4
        header.w3-container.w3-blue
            h1= title
        .w3-container
            a(href="/Alunos/adicionar" class="w3-btn w3-green w3-margin") Adicionar Novo Aluno +
            table.w3-table-all
                thead
                    tr
                        th Id
                        th Nome
                        th GitLink
                        th TPC
                        th Nota Prática
                        th Nota Teste
                        th Ações
                tbody
                    each aluno in alunos
                        tr
                            td= aluno._id
                            td= aluno.nome
                            td= aluno.gitlink
                            td
                                label TPCs done:
                                ul
                                    each num in [1, 2, 3, 4, 5, 6, 7, 8]
                                        if aluno['tpc' + num] === true
                                            li TPC #{num} done
                                
                                label TPCs not done:
                                ul
                                    each num in [1, 2, 3, 4, 5, 6, 7, 8]
                                        if !aluno['tpc' + num]
                                            li TPC #{num} not done
                            td= aluno.pratica
                            td= aluno.teste
                            td
                                a(href=`/alunos/editar/${aluno._id}` class="w3-btn w3-yellow") Editar
                                a(href=`/alunos/apagar/${aluno._id}` class="w3-btn w3-red") Remover
        footer.w3-container.w3-blue
            address Generated by EW2025 class